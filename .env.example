# Configuración local del panel admin.html.
# Copia este archivo como .env (que está en .gitignore y nunca se sube)
# y sirve la carpeta con: python3 -m http.server
# Luego abre http://localhost:8000/admin.html y el panel carga estos valores.
#
# Token fine-grained con acceso solo a este repositorio y permisos
# "Contents" y "Pull requests" en Read and write:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=cangrejadev
GITHUB_REPO=cangrejadev.github.io
GITHUB_BASE=main
